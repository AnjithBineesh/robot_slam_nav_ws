<?xml version="1.0"?>

<sdf version="1.6">
  <world name="rooms_world">

    <!-- ================================== -->
    <!-- GAZEBO FORTRESS SYSTEMS            -->
    <!-- ================================== -->

    <physics name="default_physics" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>

    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>

    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- Gazebo Fortress Sensors System -->
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- ================================== -->
    <!-- LIGHTING AND GROUND                -->
    <!-- ================================== -->

    <!-- Directional sunlight -->
<light name="sun" type="directional">
  <cast_shadows>true</cast_shadows>
  <pose>0 0 10 0 0 0</pose>
  <diffuse>0.8 0.8 0.8 1</diffuse>
  <specular>0.2 0.2 0.2 1</specular>
  <direction>-0.5 0.2 -0.9</direction>
</light>

<!-- Ground plane -->
<model name="ground_plane">
  <static>true</static>
  <link name="ground_link">
    <collision name="ground_collision">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
    </collision>
    <visual name="ground_visual">
      <geometry>
        <plane>
          <normal>0 0 1</normal>
          <size>100 100</size>
        </plane>
      </geometry>
      <material>
        <ambient>0.65 0.65 0.65 1</ambient>
        <diffuse>0.65 0.65 0.65 1</diffuse>
      </material>
    </visual>
  </link>
</model>

    <!-- ================================== -->
    <!-- OUTER WALLS                        -->
    <!-- ================================== -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>12.2 0.2 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>12.2 0.2 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0 -6 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>12.2 0.2 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>12.2 0.2 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>6 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 12.2 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 12.2 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-6 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 12.2 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 12.2 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================== -->
    <!-- CENTRAL WALLS AND PASSAGES         -->
    <!-- Leave a 1.6m central opening       -->
    <!-- ================================== -->

    <!-- Vertical wall: bottom section -->
    <model name="central_vertical_south">
      <static>true</static>
      <pose>0 -3.4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 5.2 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 5.2 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Vertical wall: top section -->
    <model name="central_vertical_north">
      <static>true</static>
      <pose>0 3.4 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.2 5.2 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.2 5.2 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Horizontal wall: left section -->
    <model name="central_horizontal_west">
      <static>true</static>
      <pose>-3.4 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>5.2 0.2 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>5.2 0.2 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Horizontal wall: right section -->
    <model name="central_horizontal_east">
      <static>true</static>
      <pose>3.4 0 0.75 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>5.2 0.2 1.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>5.2 0.2 1.5</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.75 1</ambient>
            <diffuse>0.8 0.8 0.75 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================== -->
    <!-- NORTH-WEST ROOM OBSTACLES          -->
    <!-- ================================== -->

    <model name="box_nw">
      <static>true</static>
      <pose>-4.5 4.5 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 0.8 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 0.8 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.8 0.3 0.2 1</ambient>
            <diffuse>0.8 0.3 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cyl_nw">
      <static>true</static>
      <pose>-2 4.2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.4</radius><length>0.8</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>0.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.2 0.6 0.3 1</ambient>
            <diffuse>0.2 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================== -->
    <!-- NORTH-EAST ROOM OBSTACLES          -->
    <!-- ================================== -->

    <model name="box_ne">
      <static>true</static>
      <pose>3 4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.0 0.6 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.0 0.6 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.2 0.4 0.8 1</ambient>
            <diffuse>0.2 0.4 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cyl_ne">
      <static>true</static>
      <pose>4.8 2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.35</radius><length>0.8</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.35</radius><length>0.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.7 0.2 1</ambient>
            <diffuse>0.8 0.7 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================== -->
    <!-- SOUTH-WEST ROOM OBSTACLES          -->
    <!-- ================================== -->

    <model name="box_sw">
      <static>true</static>
      <pose>-3 -4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.8 1.2 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.8 1.2 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.6 0.3 0.6 1</ambient>
            <diffuse>0.6 0.3 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cyl_sw">
      <static>true</static>
      <pose>-5 -2 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.4</radius><length>0.8</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.4</radius><length>0.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.7 0.7 1</ambient>
            <diffuse>0.3 0.7 0.7 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================== -->
    <!-- SOUTH-EAST ROOM OBSTACLES          -->
    <!-- ================================== -->

    <model name="box_se">
      <static>true</static>
      <pose>3.5 -4 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.0 1.0 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.0 1.0 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="cyl_se">
      <static>true</static>
      <pose>4.8 -1.8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder><radius>0.3</radius><length>0.8</length></cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder><radius>0.3</radius><length>0.8</length></cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.4 0.1 1</ambient>
            <diffuse>0.9 0.4 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================================== -->
    <!-- CENTRAL OBSTACLE                   -->
    <!-- ================================== -->

    <model name="box_mid">
      <static>true</static>
      <pose>-1.2 2.8 0.4 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.4 0.4 0.8</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.4 0.4 0.8</size></box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.2 1</ambient>
            <diffuse>0.7 0.7 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>