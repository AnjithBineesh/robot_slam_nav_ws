<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="diff_bot">

  <!-- ========================================== -->
  <!-- ROBOT PARAMETERS                           -->
  <!-- ========================================== -->

  <xacro:property name="PI" value="3.14159265"/>

  <xacro:property name="body_l" value="0.40"/>
  <xacro:property name="body_w" value="0.30"/>
  <xacro:property name="body_h" value="0.10"/>

  <xacro:property name="wheel_r" value="0.05"/>
  <xacro:property name="wheel_w" value="0.03"/>
  <xacro:property name="wheel_sep" value="0.34"/>
  <!-- Effective drive track calibrated against Gazebo yaw during turns. -->
  <xacro:property name="drive_wheel_sep" value="0.31"/>

  <!-- ========================================== -->
  <!-- MATERIALS                                  -->
  <!-- ========================================== -->

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1"/>
  </material>

  <material name="black">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>

  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.1 0.1 1"/>
  </material>

  <material name="grey">
    <color rgba="0.4 0.4 0.4 1"/>
  </material>

  <!-- ========================================== -->
  <!-- INERTIA MACRO                              -->
  <!-- ========================================== -->

  <xacro:macro name="box_inertia" params="m x y z">

    <inertial>
      <mass value="${m}"/>

      <inertia
        ixx="${m*(y*y+z*z)/12}"
        ixy="0"
        ixz="0"
        iyy="${m*(x*x+z*z)/12}"
        iyz="0"
        izz="${m*(x*x+y*y)/12}"/>
    </inertial>

  </xacro:macro>

  <!-- ========================================== -->
  <!-- WHEEL MACRO                                -->
  <!-- ========================================== -->

  <xacro:macro name="wheel" params="name y">

    <link name="${name}_wheel">

      <!-- Wheel body -->
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>

        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_w}"/>
        </geometry>

        <material name="black"/>
      </visual>

      <!-- White wheel stripe -->
      <visual>
        <origin xyz="${wheel_r*0.6} 0 0"/>

        <geometry>
          <box size="${wheel_r*0.8} ${wheel_w*1.1} 0.012"/>
        </geometry>

        <material name="white"/>
      </visual>

      <!-- Collision -->
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>

        <geometry>
          <cylinder radius="${wheel_r}" length="${wheel_w}"/>
        </geometry>
      </collision>

      <!-- Inertial -->
      <inertial>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>

        <mass value="0.5"/>

        <inertia
          ixx="0.0005"
          ixy="0"
          ixz="0"
          iyy="0.0005"
          iyz="0"
          izz="0.0006"/>
      </inertial>

    </link>

    <!-- Wheel joint -->
    <joint name="${name}_wheel_joint" type="continuous">

      <parent link="base_link"/>
      <child link="${name}_wheel"/>

      <origin xyz="0 ${y} -0.025"/>

      <axis xyz="0 1 0"/>

    </joint>

    <!-- Wheel friction -->
    <gazebo reference="${name}_wheel">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
    </gazebo>

  </xacro:macro>

  <!-- ========================================== -->
  <!-- CASTER MACRO                               -->
  <!-- ========================================== -->

  <xacro:macro name="caster" params="name x">

    <link name="${name}_caster">

      <visual>
        <geometry>
          <sphere radius="0.025"/>
        </geometry>
        <material name="grey"/>
      </visual>

      <collision>
        <geometry>
          <sphere radius="0.025"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.1"/>

        <inertia
          ixx="0.00001"
          ixy="0"
          ixz="0"
          iyy="0.00001"
          iyz="0"
          izz="0.00001"/>
      </inertial>

    </link>

    <joint name="${name}_caster_joint" type="fixed">

      <parent link="base_link"/>
      <child link="${name}_caster"/>

      <origin xyz="${x} 0 -0.05"/>

    </joint>

    <!-- Keep caster as its own link (no fixed-joint lumping) so its
         friction is not merged into base_link -->
    <gazebo reference="${name}_caster_joint">
      <preserveFixedJoint>true</preserveFixedJoint>
    </gazebo>

    <!-- Near-frictionless caster: stops it scrubbing the floor when turning -->
    <gazebo reference="${name}_caster">
      <mu1>0.001</mu1>
      <mu2>0.001</mu2>
      <kp>500000.0</kp>
      <kd>10.0</kd>
    </gazebo>

  </xacro:macro>

  <!-- ========================================== -->
  <!-- BASE FOOTPRINT                             -->
  <!-- ========================================== -->

  <link name="base_footprint"/>

  <!-- ========================================== -->
  <!-- MAIN CHASSIS                               -->
  <!-- ========================================== -->

  <link name="base_link">

    <visual>
      <origin xyz="0 0 0"/>

      <geometry>
        <box size="${body_l} ${body_w} ${body_h}"/>
      </geometry>

      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0"/>

      <geometry>
        <box size="${body_l} ${body_w} ${body_h}"/>
      </geometry>
    </collision>

    <xacro:box_inertia
      m="5.0"
      x="${body_l}"
      y="${body_w}"
      z="${body_h}"/>

  </link>

  <joint name="base_footprint_joint" type="fixed">

    <parent link="base_footprint"/>
    <child link="base_link"/>

    <origin xyz="0 0 0.075"/>

  </joint>

  <!-- ========================================== -->
  <!-- WHEELS AND CASTERS                         -->
  <!-- ========================================== -->

  <xacro:wheel name="left" y="${wheel_sep/2}"/>
  <xacro:wheel name="right" y="${-wheel_sep/2}"/>

  <xacro:caster name="front" x="0.15"/>
  <xacro:caster name="rear" x="-0.15"/>

  <!-- ========================================== -->
  <!-- LIDAR                                      -->
  <!-- ========================================== -->

  <link name="lidar_link">

    <visual>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>

      <material name="red"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.04" length="0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.1"/>

      <inertia
        ixx="0.0001"
        ixy="0"
        ixz="0"
        iyy="0.0001"
        iyz="0"
        izz="0.0001"/>
    </inertial>

  </link>

  <joint name="lidar_joint" type="fixed">

    <parent link="base_link"/>
    <child link="lidar_link"/>

    <origin xyz="0.05 0 0.075"/>

  </joint>

  <!-- ========================================== -->
  <!-- CAMERA                                     -->
  <!-- ========================================== -->

  <link name="camera_link">

    <visual>
      <geometry>
        <box size="0.03 0.08 0.03"/>
      </geometry>

      <material name="grey"/>
    </visual>

    <collision>
      <geometry>
        <box size="0.03 0.08 0.03"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.05"/>

      <inertia
        ixx="0.00001"
        ixy="0"
        ixz="0"
        iyy="0.00001"
        iyz="0"
        izz="0.00001"/>
    </inertial>

  </link>

  <joint name="camera_joint" type="fixed">

    <parent link="base_link"/>
    <child link="camera_link"/>

    <origin xyz="0.20 0 0.03"/>

  </joint>

  <!-- Camera optical frame -->

  <link name="camera_optical_link"/>

  <joint name="camera_optical_joint" type="fixed">

    <parent link="camera_link"/>
    <child link="camera_optical_link"/>

    <origin rpy="${-PI/2} 0 ${-PI/2}"/>

  </joint>

  <!-- ========================================== -->
  <!-- GAZEBO FORTRESS DIFFERENTIAL DRIVE         -->
  <!-- ========================================== -->

  <gazebo>

    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>${drive_wheel_sep}</wheel_separation>
      <wheel_radius>${wheel_r}</wheel_radius>

      <topic>/cmd_vel</topic>

      <odom_topic>/odom</odom_topic>

      <tf_topic>/model/diff_bot/tf</tf_topic>

      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>

      <odom_publish_frequency>50</odom_publish_frequency>

      <!-- Limit turning speed and ramp acceleration so wheels/casters
           don't slip when teleop commands a sharp turn -->
      <max_linear_velocity>0.5</max_linear_velocity>
      <min_linear_velocity>-0.5</min_linear_velocity>
      <max_angular_velocity>0.6</max_angular_velocity>
      <min_angular_velocity>-0.6</min_angular_velocity>
      <max_linear_acceleration>0.8</max_linear_acceleration>
      <min_linear_acceleration>-0.8</min_linear_acceleration>
      <max_angular_acceleration>1.0</max_angular_acceleration>
      <min_angular_acceleration>-1.0</min_angular_acceleration>

    </plugin>

    <!-- Joint state publisher -->

    <plugin
      filename="libignition-gazebo-joint-state-publisher-system.so"
      name="ignition::gazebo::systems::JointStatePublisher"/>

  </gazebo>

  <!-- ========================================== -->
  <!-- GAZEBO FORTRESS LIDAR                      -->
  <!-- ========================================== -->

  <gazebo reference="lidar_link">

    <sensor name="lidar" type="gpu_lidar">

      <pose>0 0 0 0 0 0</pose>

      <topic>/scan</topic>

      <gz_frame_id>lidar_link</gz_frame_id>
      <ignition_frame_id>lidar_link</ignition_frame_id>

      <update_rate>10</update_rate>

      <always_on>true</always_on>

      <visualize>true</visualize>

      <lidar>

        <scan>

          <horizontal>

            <samples>360</samples>
            <resolution>1</resolution>

            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>

          </horizontal>

        </scan>

        <range>

          <min>0.12</min>
          <max>10.0</max>
          <resolution>0.01</resolution>

        </range>

        <noise>

          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>

        </noise>

      </lidar>

    </sensor>

  </gazebo>

  <!-- ========================================== -->
  <!-- GAZEBO FORTRESS RGB-D CAMERA               -->
  <!-- ========================================== -->

  <gazebo reference="camera_link">

    <sensor name="depth_camera" type="rgbd_camera">

      <pose>0 0 0 0 0 0</pose>

      <topic>/camera</topic>

      <update_rate>10</update_rate>

      <always_on>true</always_on>

      <visualize>false</visualize>

      <camera>

        <horizontal_fov>1.047</horizontal_fov>

        <image>

          <width>160</width>
          <height>120</height>

          <format>R8G8B8</format>

        </image>

        <clip>

          <near>0.3</near>
          <far>8.0</far>

        </clip>

      </camera>

    </sensor>

  </gazebo>

</robot>